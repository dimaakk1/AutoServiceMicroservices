# Copy to .env for direct local launch. Use the SAME JWT settings as UsersService.
Jwt__Key=replace-with-the-users-service-signing-key
Jwt__Issuer=AutoService
Jwt__Audience=AutoServiceUsers
ConnectionStrings__VehiclesDb=Server=localhost,1433;Database=VehiclesDb;User Id=sa;Password=replace-with-your-sql-password;TrustServerCertificate=True;
